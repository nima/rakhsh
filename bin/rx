#!/usr/bin/env bash
set -uo pipefail

export PATH="/opt/homebrew/bin:${PATH}"

REQUIRED=(nvim timeout)
for req in "${REQUIRED[@]}"; do
  _=$(command -v "${req}") || exit 9
done

export TERM='xterm-256color'
export PS4='+ ${BASH_SOURCE}:${LINENO} ${FUNCNAME[0]:+${FUNCNAME[0]}(): }'
NVIM="$(command -v nvim)"
NVIM_OPTS=( "-V3/tmp/nvim.log" )

export NVIM_APPNAME=rakhsh
CONFIG_DIR="$("${NVIM}" --headless --clean --cmd 'lua io.stdout:write(vim.fn.stdpath("config"))' +qa)"
DATA_DIR="$(  "${NVIM}" --headless --clean --cmd 'lua io.stdout:write(vim.fn.stdpath("data"))'   +qa)"
STATE_DIR="$( "${NVIM}" --headless --clean --cmd 'lua io.stdout:write(vim.fn.stdpath("state"))'  +qa)"
CACHE_DIR="$( "${NVIM}" --headless --clean --cmd 'lua io.stdout:write(vim.fn.stdpath("cache"))'  +qa)"

session="${STATE_DIR}/it2sid"
: "${ITERM_SESSION_ID:=headless}"
vscode="/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"

function :lca() {
  [ $# -eq 0 ] && { pwd; return; }
  [ $# -eq 1 ] && { realpath "$1"; return; }

  local lca="$(realpath "${1}")"; shift
  lca="${lca%/*}"

  local path
  for path in "$@"; do
    path="$(realpath "${path}")"
    while [[ "${path}/" != "${lca}/"* ]]; do
      [ -z "$lca" ] && { lca="/"; break 2; }
      lca="${lca%/*}"
    done
  done

  [ -z "$lca" ] && echo "/" || echo "$lca"
}

function :mksocket() {
  [[ "${NVIM_LISTEN_ADDRESSr:-DEAD}" == "DEAD" ]] || return

  ROOT="/"
  SOCKET="${STATE_DIR}/server.pipe"
  local lca="$(:lca "$@")"
  local ideid; ideid="$(shasum -a1 <<< "${lca}"|cut -c1-12)"

  local _ideid
  local _socket
  while [[ "${lca}" != "/" ]]; do
    _ideid="$(shasum -a1 <<< "${lca}"|cut -c1-12)"
    _socket="${STATE_DIR}/server-${_ideid}.pipe"
    _gitdir="${lca}/.git"
    if [[ -S "${_socket}" ]] || [[ -d "${_gitdir}" ]]; then
      SOCKET="${_socket}"
      ROOT="${lca}"
      break
    fi

    lca="$(dirname "${lca}")"
  done

  export ROOT
  export SOCKET
  export NVIM_LISTEN_ADDRESS="${SOCKET}"
  mkdir -p "$(dirname "${SOCKET}")"
  return 0
}

function :clean() {
  rm -f "${CACHE_DIR}/it2sid"
  rm -f "${SOCKET?}"
  pkill -9 -f "${NVIM}"
}

function :debug() {
  printf "#%079d\n" 0 | tr '0' '#'
  echo "Socket:"
  [[ ! -S "${SOCKET}" ]] || ls -l "${SOCKET}"
  printf "#%079d\n" 0 | tr '0' '-'
  echo "Processes:"
  pgrep -f 'nvim' || true
  printf "#%079d\n" 0 | tr '0' '#'
}

function :vsc() {
  # VS Code CLI must exist
  [[ -x "${vscode}" ]] || return 0

  # Only do anything if VS Code is already running
  pgrep -qf "Code" >/dev/null 2>&1 || return 0

  # Normalize arguments to absolute file paths and strip any :ln[:col] suffix
  local -a files=()
  local token path
  for token in "$@"; do
    path="${token}"
    if [[ "${path}" =~ ^(.*):([0-9]+)(:[0-9]+)?$ ]]; then
      path="${BASH_REMATCH[1]}"
    fi
    path="$(realpath "${path}" 2>/dev/null)" || continue
    files+=( "${path}" )
  done

  (( ${#files[@]} > 0 )) || return 0

  # Do not steal focus / switch desktop
  open -g -a "Visual Studio Code" "${files[@]}" >/dev/null 2>&1 || true
  return 0
}

function :socket() {
  [[ -S "${SOCKET}" ]] && return 0 || return 1
}

function :alive() {
  :socket || return $?

  timeout 3.0 "${NVIM}" --headless --server "${SOCKET}" --remote-expr 0 >/dev/null 2>&1 || return 2
  return 0
}

function :healthy() {
  :alive || return $?
  return 0
}

function :headless() {
  local -a args=( "${NVIM}" "${NVIM_OPTS[@]}" )

  #+ Usage: RX_STARTUPTIME=/tmp/rakhsh.startuptime.log bin/rx
  if [[ -n "${RX_STARTUPTIME:-}" ]]; then
    args+=( "--startuptime" "${RX_STARTUPTIME}" )
  fi

  args+=( "--headless" "--listen" "${SOCKET}" )

  nohup "${args[@]}" </dev/null >/dev/null 2>&1 &
  return 0
}

function :kill() {
  local pid=$1
  [[ -n "${pid}" ]] || return 1
  [[ "${pid}" =~ ^[0-9]+$ ]] || return 1

  local i=0
  local s=1
  local -a arrows=( TERM TERM TERM KILL )
  while kill -0 "${pid}" >/dev/null 2>&1; do
    kill -${arrows[i]} "${pid}"
    (( i++ ))
    sleep $s
    ((s*=2))
  done
  kill -0 "${pid}" >/dev/null 2>&1 && return 6
  return 0
}

function :boot() {
  read -re LINES COLUMNS < <(stty size 2>/dev/null)
  export LINES COLUMNS

  :mksocket "${@%/*}"
  :alive && :healthy && return 0

  local pid
  pid=$(:pid 2>/dev/null) && {
    :kill "${pid}" || return $?
  } || true

  rm -f "${SOCKET}"
  :headless
  :wait.block || return $?

  return 0
}

function :pid() {
  :socket || return $?

  local pid
  pid=$("${NVIM}" --headless --server "${SOCKET}" --remote-expr 'getpid()' 2>/dev/null) || return 8
  [[ "${pid}" =~ ^[0-9]+$ ]] || return 9

  echo "${pid}"
  return 0
}

function :attach() {
  #local COLUMNS=$(tput cols 2>/dev/null)
  #local LINES=$(tput lines 2>/dev/null)
  local clicked=$1; shift

  local -a tokens=( "$@" )
  :mksocket "${tokens[@]%/*}"

  [[ $# -eq 0 ]] || ( :vsc "$@" )&

  _tui=$("${NVIM}" --headless --server "${SOCKET}" --remote-expr "len(luaeval('vim.api.nvim_list_uis()'))" 2>/dev/null || echo "")
  [[ $# -gt 0 ]] || return 0

  local token
  for token in "${tokens[@]}"; do
    "${NVIM}" --headless --server "${SOCKET}" --remote-send "<Cmd>RakhshOpen ${token}<CR>" || return 11
  done

  return 0
}

function :same() {
  [[ -f "${session}" ]] || return 0

  local recorded
  recorded=$(<"${session}") || return 13  # session file unreadable / invalid

  local current
  current=$(cut -d: -f2 <<< "$ITERM_SESSION_ID") || return 12

  [[ "${current}" == "${recorded}" ]]
  return $?
}

function :mirror.exec() {
  exec "${NVIM}" --server "${SOCKET}" --remote-ui
}

function :tui() {
  local attached
  attached=$("${NVIM}" --headless --server "${SOCKET}" --remote-expr "len(luaeval('vim.api.nvim_list_uis()'))" 2>/dev/null) || return 14
  (( attached == 0 )) && return 15 || return 0
}

function :tui.exec() {
  # Require a healthy headless server before we even consider a UI.
  :healthy || return $?

  :tui
  local e=$?
  case $e in
    0)
      # At least one UI is already attached to this server.
      # Do not try to grab UI again; files were already attached via :attach.
      return 0
      ;;
	14|15)
      # Either we couldn't query UIs, or there are none yet.
      # In both cases, this terminal may become the UI owner.
      [[ -t 1 ]] || return 0
      exec "${NVIM}" --server "${SOCKET}" --remote-ui
      ;;
    *)
      # Unexpected status from :tui; propagate it as an error.
      return $e
      ;;
  esac
}

function :e(){ keyhex=($(echo -n "$1" | xxd -p -c1)); i=0; xxd -p -c1 | while read -r b; do k=${keyhex[$((i%${#keyhex[@]}))]}; printf "%02x\n" $((0x$b ^ 0x$k)); ((i++)); done | xxd -r -p | base64; }

function :d(){ keyhex=($(echo -n "$1" | xxd -p -c1)); i=0; base64 -d | xxd -p -c1 | while read -r b; do k=${keyhex[$((i%${#keyhex[@]}))]}; printf "%02x n" $((0x$b ^ 0x$k)); ((i++)); done | xxd -r -p; }

function :wait.block() {
  local i=0 max=40
  while (( i < max )); do
    :healthy && return 0
    sleep 0.05
    ((i++))
  done
  return 10
}

if [[ $# -eq 1 ]] && [[ "$1" == '--mirror' ]]; then
  #+ Mode: CLI/Mirror
  :boot
  :mirror.exec
elif [[ $# -eq 3 ]] && [[ "$1" == '--iterm' ]]; then
  #+ Mode: iTerm/Clicked
  :boot "$3"
  let clicked=1
  :attach ${clicked} "$3"
  :tui.exec  # MAY exec into UI (and writes session on first TTY)
elif [[ $# -eq 1 ]] && [[ "$1" == '--status' ]]; then
  #+ Mode: CLI/Info
  :boot
  #! TODO
  #"${NVIM}" --server "${SOCKET}" --headless --remote-expr "luaeval('require(\"core.status\").status_summary()')" +qa
  echo "Not Implemented"
  exit 1
else
  #+ Mode: CLI/Terminal
  :boot "$@"
  let clicked=0
  :attach ${clicked} "$@"
  :tui.exec  # MAY exec into UI (and writes session on first TTY)
fi
exit $?
